@page "/"
@using System.Net.Http.Headers
@rendermode InteractiveServer
@inject ApiConfig ApiConfig
@inject HttpClient Http
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>NetFrames - Home</PageTitle>

<div class="page-header">
    @if (currentFolder is null)
    {
        <h1>Photo Collection</h1>
    }
    else
    {
        <h1 class="breadcrumb-title">
            <a href="javascript:void(0)" class="breadcrumb-link" @onclick="() => OpenFolder(null)">Photo Collection</a>
            <i class="bi bi-chevron-right breadcrumb-sep"></i>@currentFolder.Name
        </h1>
    }
    @if (selectedIds.Count > 0)
    {
        <span class="selected-count-label">@selectedIds.Count Selected</span>
        <button class="btn btn-outline-secondary btn-sm" @onclick="() => selectedIds.Clear()">Clear Selection</button>
        @if (selectedIds.Count < FilteredImages.Count())
        {
            <button class="btn btn-outline-secondary btn-sm select-all-btn" @onclick="SelectAll" title="Select all visible images">
                Select All
            </button>
        }
        <button class="btn btn-outline-secondary btn-sm" @onclick="OpenMoveDialog" title="Move selected images to a folder">
            <i class="bi bi-folder-symlink me-1"></i> Move to…
        </button>
        @if (GetVisibilityAction() is string action)
        {
            <button class="btn btn-outline-secondary btn-sm toggle-selected-btn" @onclick="ToggleSelectedVisibility" title="@action selected images">
                <i class="bi @(action == "Hide" ? "bi-eye-slash" : "bi-eye") me-1"></i> @action
            </button>
        }
        <button class="btn btn-outline-danger btn-sm delete-selected-btn" @onclick="DeleteSelected" disabled="@isDeleting">
            @if (isDeleting)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
            }
            else
            {
                <i class="bi bi-trash me-1"></i>
            }
            Delete
        </button>
    }
</div>

<div class="filter-bar">
    <div class="filter-pills">
        <button class="filter-pill @(activeFilter == "All" ? "active" : "")" @onclick='() => SetFilter("All")'>All</button>
        <button class="filter-pill @(activeFilter == "Enabled" ? "active" : "")" @onclick='() => SetFilter("Enabled")'>Enabled</button>
        <button class="filter-pill @(activeFilter == "Disabled" ? "active" : "")" @onclick='() => SetFilter("Disabled")'>Disabled</button>
    </div>
    @if (images != null)
    {
        var scoped = ScopedImages.ToList();
        <span class="image-count-label">@scoped.Count photo@(scoped.Count != 1 ? "s" : "") · @scoped.Count(i => i.Enabled) enabled</span>
    }
    @if (currentFolder is null)
    {
        <button class="btn btn-outline-secondary btn-sm new-folder-btn" @onclick="OpenFolderDialog">
            <i class="bi bi-folder-plus me-1"></i> New folder
        </button>
    }
    else
    {
        <div class="folder-actions">
            <button class="btn btn-outline-secondary btn-sm" @onclick="() => OpenFolderDialog(currentFolder)" title="Rename folder">
                <i class="bi bi-pencil me-1"></i> Rename
            </button>
            <button class="btn btn-outline-danger btn-sm" @onclick="() => AskDeleteFolder(currentFolder)" title="Delete folder">
                <i class="bi bi-trash me-1"></i> Delete folder
            </button>
        </div>
    }
</div>

@if (isLoading)
{
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
}
else
{
    <div class="image-grid">
        <div class="image-container upload-zone-grid @(isDragOver ? "drag-over" : "")"
             @ondragenter="OnDragEnter"
             @ondragover="OnDragOver"
             @ondragleave="OnDragLeave"
             @ondrop="OnDrop">

            @if (isUploading)
            {
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Uploading...</span>
                </div>
            }
            else
            {
                <i class="bi bi-plus-lg upload-grid-icon"></i>
                <span class="upload-grid-text">Add Photo</span>
            }

            <InputFile OnChange="OnInputFileChange" accept=".jpg,.jpeg" class="upload-input" multiple />
        </div>

        @if (currentFolder is null)
        {
            @foreach (var folder in folders)
            {
                <div @key="folder.Id"
                     class="image-container folder-tile @(dropFolderId == folder.Id ? "drag-over" : "") @(folder.IsHidden ? "disabled" : "")"
                     @onclick="() => OpenFolder(folder.Id)"
                     @ondragenter="() => dropFolderId = folder.Id"
                     @ondragover="() => dropFolderId = folder.Id"
                     @ondragover:preventDefault
                     @ondragleave="() => { if (dropFolderId == folder.Id) dropFolderId = null; }"
                     @ondrop="() => OnDropOnFolder(folder.Id)"
                     @ondrop:preventDefault
                     @ondrop:stopPropagation>
                    @if (folder.CoverId is not null)
                    {
                        <img src="@($"{ApiConfig.BaseUrl}/images/{folder.CoverId}/thumb")" class="grid-image folder-cover" alt="" draggable="false" />
                    }
                    else
                    {
                        <div class="grid-image folder-cover folder-empty"><i class="bi bi-folder2-open"></i></div>
                    }
                    <div class="folder-label" title="@folder.Name">
                        <i class="bi bi-folder-fill me-2"></i>
                        <span class="folder-name">@folder.Name</span>
                    </div>
                    <span class="folder-count">@folder.Count</span>
                </div>
            }
        }

        @if (FilteredImages.Any())
        {
            @foreach (var img in VisibleImages)
            {
                var isSelected = selectedIds.Contains(img.Id);
                <div @key="img.Id" class="image-container @(isSelected ? "selected" : "") @(!img.Enabled ? "disabled" : "")">
                    <button class="select-btn @(isSelected ? "checked" : "")"
                            @onclick="() => ToggleSelect(img.Id)"
                            @onclick:stopPropagation
                            title="Select image">
                        <i class="bi @(isSelected ? "bi-check-circle-fill" : "bi-check-circle")"></i>
                    </button>
                    <img src="@($"{ApiConfig.BaseUrl}/images/{img.Id}/thumb")"
                         class="grid-image"
                         decoding="async"
                         draggable="true"
                         @ondragstart="() => OnImageDragStart(img.Id)"
                         @ondragend="() => { draggingIds = null; dropFolderId = null; }"
                         @onclick="() => ShowModal(img.Id)"
                         alt="Gallery image" />
                </div>
            }
        }
    </div>

    @if (HasMore)
    {
        <div @key="visibleCount" @ref="sentinel" class="load-more-sentinel"></div>
    }
}

@if (!string.IsNullOrEmpty(uploadStatus))
{
    <div class="toast-notification @(uploadSuccess ? "toast-success" : "toast-error")">
        <i class="bi @(uploadSuccess ? "bi-check-circle" : "bi-exclamation-triangle") me-2"></i>
        @uploadStatus
    </div>
}

@if (showConfirmDelete)
{
    <div class="modal-backdrop" @onclick="() => showConfirmDelete = false">
        <div class="confirm-dialog" @onclick:stopPropagation>
            <h5>Confirm Deletion</h5>
            <p>Are you sure you want to delete selected photo(s)?</p>
            <div class="confirm-dialog-actions">
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => showConfirmDelete = false">Cancel</button>
                <button class="btn btn-sm btn-danger" @onclick="OnConfirmDelete">Delete</button>
            </div>
        </div>
    </div>
}

@if (showFolderDialog)
{
    <div class="modal-backdrop" @onclick="() => showFolderDialog = false">
        <div class="confirm-dialog" @onclick:stopPropagation>
            <h5>@(editingFolder is null ? "New Folder" : "Rename Folder")</h5>
            <input class="form-control form-control-sm mb-2" placeholder="Folder name" maxlength="60"
                   @bind="folderNameInput" @bind:event="oninput" @onkeydown="OnFolderNameKey" />
            @if (!string.IsNullOrEmpty(folderError))
            {
                <div class="folder-error">@folderError</div>
            }
            <div class="confirm-dialog-actions">
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => showFolderDialog = false">Cancel</button>
                <button class="btn btn-sm btn-primary" @onclick="SaveFolder" disabled="@string.IsNullOrWhiteSpace(folderNameInput)">Save</button>
            </div>
        </div>
    </div>
}

@if (folderToDelete is not null)
{
    <div class="modal-backdrop" @onclick="() => folderToDelete = null">
        <div class="confirm-dialog" @onclick:stopPropagation>
            <h5>Delete Folder</h5>
            <p>Delete "@folderToDelete.Name"? Its photos are kept and move back to the main collection.</p>
            <div class="confirm-dialog-actions">
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => folderToDelete = null">Cancel</button>
                <button class="btn btn-sm btn-danger" @onclick="ConfirmDeleteFolder">Delete</button>
            </div>
        </div>
    </div>
}

@if (showMoveDialog)
{
    <div class="modal-backdrop" @onclick="() => showMoveDialog = false">
        <div class="confirm-dialog" @onclick:stopPropagation>
            <h5>Move @selectedIds.Count photo@(selectedIds.Count != 1 ? "s" : "") to…</h5>
            <div class="move-list">
                @if (currentFolder is not null)
                {
                    <button class="move-option" @onclick="() => MoveImages(selectedIds.ToList(), null)">
                        <i class="bi bi-images me-2"></i> Main collection
                    </button>
                }
                @foreach (var folder in folders.Where(f => f.Id != currentFolder?.Id))
                {
                    <button class="move-option" @onclick="() => MoveImages(selectedIds.ToList(), folder.Id)">
                        <i class="bi bi-folder-fill me-2"></i> @folder.Name
                    </button>
                }
                @if (folders.Count == 0 && currentFolder is null)
                {
                    <p class="text-muted mb-0">No folders yet. Create one with "New folder".</p>
                }
            </div>
            <div class="confirm-dialog-actions">
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => showMoveDialog = false">Cancel</button>
            </div>
        </div>
    </div>
}

@if (showModal)
{
    <div class="modal-backdrop" @onclick="CloseModal">
        <div class="modal-content" @onclick:stopPropagation>
            <div>
                <img
                    src="@($"{ApiConfig.BaseUrl}/images/{selectedId}")"
                    class="modal-image"
                    alt="Large view" />
            </div>

            @if (imageMetadata != null)
            {
                <div class="modal-metadata">
                    <span>@($"{imageMetadata.Width} x {imageMetadata.Height}")</span>
                    <span>@imageMetadata.UploadedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</span>
                </div>
            }

            <div style="display: flex; align-items: center; margin-top: 10px; width:100%">
                <p style="flex: 1; margin: 0; font-size: 0.8rem; color: var(--text-muted);">@(selectedId)@(imageMetadata?.Extension)</p>
                <button class="visibility-btn" @onclick="ToggleVisibility" title="@(IsSelectedEnabled() ? "Disable for clients" : "Enable for clients")">
                    <i class="bi @(IsSelectedEnabled() ? "bi-eye" : "bi-eye-slash")"></i>
                </button>
                <button class="trash-btn" @onclick="DeleteImage" title="Delete image" style="margin-left: 8px;">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool isUploading;
    private bool isDeleting;
    private bool uploadSuccess;
    private bool isDragOver;
    private bool showModal = false;
    private bool showConfirmDelete = false;
    private Func<Task>? confirmDeleteAction;
    private int confirmDeleteCount;
    private string? selectedId;
    private string? uploadStatus;
    private List<ImageInfo>? images;
    private ImageMetadata? imageMetadata;
    private HashSet<string> selectedIds = new();

    private string activeFilter = "All";
    private record ImageInfo(string Id, bool Enabled, string? FolderId = null);
    private record ImageMetadata(string Extension, DateTime UploadedAt, int Width, int Height);
    private record FolderInfo(string Id, string Name, int Count, string? CoverId, int EnabledCount = 0)
    {
        // A folder is fully hidden when it has photos and none of them are enabled.
        public bool IsHidden => Count > 0 && EnabledCount == 0;
    }
    private record UploadResult(string Id);

    // Folders
    private List<FolderInfo> folders = new();
    private FolderInfo? currentFolder;
    private string? dropFolderId;
    private List<string>? draggingIds;
    private bool showFolderDialog;
    private bool showMoveDialog;
    private FolderInfo? editingFolder;
    private FolderInfo? folderToDelete;
    private string folderNameInput = "";
    private string? folderError;

    // Images in the current view: the top level shows unfiled images, a folder shows its own.
    private IEnumerable<ImageInfo> ScopedImages =>
        (images ?? new List<ImageInfo>()).Where(i => i.FolderId == currentFolder?.Id);

    private IEnumerable<ImageInfo> FilteredImages => activeFilter switch
    {
        "Enabled" => ScopedImages.Where(i => i.Enabled),
        "Disabled" => ScopedImages.Where(i => !i.Enabled),
        _ => ScopedImages
    };

    private async Task LoadFoldersAsync()
    {
        folders = await Http.GetFromJsonAsync<List<FolderInfo>>($"{ApiConfig.BaseUrl}/folders") ?? new();
        if (currentFolder is not null)
            currentFolder = folders.FirstOrDefault(f => f.Id == currentFolder.Id);
    }

    private async Task RefreshAsync()
    {
        images = await Http.GetFromJsonAsync<List<ImageInfo>>($"{ApiConfig.BaseUrl}/images/list/all");
        await LoadFoldersAsync();
    }

    private void OpenFolder(string? id)
    {
        currentFolder = id is null ? null : folders.FirstOrDefault(f => f.Id == id);
        selectedIds.Clear();
        visibleCount = PageSize;
        observedCount = -1;
    }

    private void OpenFolderDialog() => OpenFolderDialog(null);

    private void OpenFolderDialog(FolderInfo? folder)
    {
        editingFolder = folder;
        folderNameInput = folder?.Name ?? "";
        folderError = null;
        showFolderDialog = true;
    }

    private async Task OnFolderNameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SaveFolder();
    }

    private async Task SaveFolder()
    {
        if (string.IsNullOrWhiteSpace(folderNameInput)) return;

        var body = new { name = folderNameInput.Trim() };
        var response = editingFolder is null
            ? await Http.PostAsJsonAsync($"{ApiConfig.BaseUrl}/folders", body)
            : await Http.PutAsJsonAsync($"{ApiConfig.BaseUrl}/folders/{editingFolder.Id}", body);

        if (!response.IsSuccessStatusCode)
        {
            folderError = await response.Content.ReadAsStringAsync();
            return;
        }

        showFolderDialog = false;
        await LoadFoldersAsync();
    }

    private void AskDeleteFolder(FolderInfo folder) => folderToDelete = folder;

    private async Task ConfirmDeleteFolder()
    {
        if (folderToDelete is null) return;
        var id = folderToDelete.Id;
        folderToDelete = null;

        var response = await Http.DeleteAsync($"{ApiConfig.BaseUrl}/folders/{id}");
        if (response.IsSuccessStatusCode)
        {
            await RefreshAsync();
            OpenFolder(null);
        }
    }

    private void OpenMoveDialog()
    {
        if (selectedIds.Count > 0) showMoveDialog = true;
    }

    private void OnImageDragStart(string id)
    {
        // Dragging a selected image moves the whole selection; otherwise just that image.
        draggingIds = selectedIds.Contains(id) ? selectedIds.ToList() : new List<string> { id };
    }

    private async Task OnDropOnFolder(string folderId)
    {
        dropFolderId = null;
        var ids = draggingIds;
        draggingIds = null;
        if (ids is { Count: > 0 })
            await MoveImages(ids, folderId);
    }

    private async Task MoveImages(List<string> ids, string? folderId)
    {
        showMoveDialog = false;
        var response = await Http.PostAsJsonAsync($"{ApiConfig.BaseUrl}/images/move", new { imageIds = ids, folderId });
        if (response.IsSuccessStatusCode)
        {
            await RefreshAsync();
            foreach (var id in ids) selectedIds.Remove(id);
        }
    }

    private const int PageSize = 36;
    private int visibleCount = PageSize;
    private ElementReference sentinel;
    private int observedCount = -1;
    private DotNetObjectReference<Images>? selfRef;

    private IEnumerable<ImageInfo> VisibleImages => FilteredImages.Take(visibleCount);
    private bool HasMore => FilteredImages.Count() > visibleCount;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Arm the observer once per batch; the sentinel element is recreated whenever visibleCount changes.
        if (HasMore && observedCount != visibleCount)
        {
            observedCount = visibleCount;
            selfRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("observeSentinel", sentinel, selfRef);
        }
    }

    [JSInvokable]
    public void LoadMore()
    {
        visibleCount += PageSize;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        selfRef?.Dispose();
        try { await JS.InvokeVoidAsync("disconnectSentinel"); }
        catch (JSDisconnectedException) { }
    }

    private void SetFilter(string filter)
    {
        activeFilter = filter;
        selectedIds.Clear();
        visibleCount = PageSize;
        observedCount = -1;
    }

    private void SelectAll()
    {
        foreach (var img in FilteredImages)
            selectedIds.Add(img.Id);
    }

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            images = await Http.GetFromJsonAsync<List<ImageInfo>>($"{ApiConfig.BaseUrl}/images/list/all");
            await LoadFoldersAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool IsSelectedEnabled()
    {
        return images?.FirstOrDefault(i => i.Id == selectedId)?.Enabled ?? true;
    }

    private string? GetVisibilityAction()
    {
        if (images == null || selectedIds.Count == 0) return null;
        var selected = images.Where(i => selectedIds.Contains(i.Id)).ToList();
        bool hasEnabled = selected.Any(i => i.Enabled);
        bool hasDisabled = selected.Any(i => !i.Enabled);
        if (hasEnabled && hasDisabled) return null;
        return hasEnabled ? "Hide" : "Show";
    }

    private async Task ToggleVisibility()
    {
        if (selectedId is null) return;

        var response = await Http.PostAsync($"{ApiConfig.BaseUrl}/images/{selectedId}/toggle", null);
        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<ImageInfo>();
            if (result != null && images != null)
            {
                var index = images.FindIndex(i => i.Id == result.Id);
                if (index >= 0)
                    images[index] = result;
            }
            await LoadFoldersAsync();
            StateHasChanged();
        }
    }

    private async Task ToggleSelectedVisibility()
    {
        foreach (var id in selectedIds.ToList())
        {
            var response = await Http.PostAsync($"{ApiConfig.BaseUrl}/images/{id}/toggle", null);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ImageInfo>();
                if (result != null && images != null)
                {
                    var index = images.FindIndex(i => i.Id == result.Id);
                    if (index >= 0)
                        images[index] = result;
                }
            }
        }
        selectedIds.Clear();
        await LoadFoldersAsync();
        StateHasChanged();
    }

    private void ToggleSelect(string id)
    {
        if (!selectedIds.Remove(id))
            selectedIds.Add(id);
    }

    private void DeleteSelected()
    {
        if (selectedIds.Count == 0) return;
        confirmDeleteCount = selectedIds.Count;
        confirmDeleteAction = PerformDeleteSelected;
        showConfirmDelete = true;
    }

    private async Task PerformDeleteSelected()
    {
        isDeleting = true;
        var toDelete = selectedIds.ToList();
        var deletedCount = 0;

        foreach (var id in toDelete)
        {
            var response = await Http.DeleteAsync($"{ApiConfig.BaseUrl}/images/{id}");
            if (response.IsSuccessStatusCode)
            {
                images?.RemoveAll(i => i.Id == id);
                selectedIds.Remove(id);
                deletedCount++;
            }
        }

        await LoadFoldersAsync();
        isDeleting = false;
        uploadSuccess = true;
        uploadStatus = $"{deletedCount} image{(deletedCount != 1 ? "s" : "")} deleted.";
        _ = DismissToastAfterDelay();
    }

    private void OnDragEnter() => isDragOver = true;
    private void OnDragOver() => isDragOver = true;
    private void OnDragLeave() => isDragOver = false;
    private void OnDrop() => isDragOver = false;

    private CancellationTokenSource? toastCts;

    private const int MaxFilesPerUpload = 50;

    private async Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        uploadStatus = null;

        var files = e.GetMultipleFiles(MaxFilesPerUpload);

        isUploading = true;
        StateHasChanged();

        var successCount = 0;
        var uploadedIds = new List<string>();
        var errors = new List<string>();

        foreach (var file in files)
        {
            if (!file.ContentType.StartsWith("image/"))
            {
                errors.Add($"{file.Name}: not a valid image file.");
                continue;
            }

            try
            {
                using var fileData = new MemoryStream();
                await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(fileData);
                fileData.Position = 0;

                using var content = new MultipartFormDataContent();
                var streamContent = new StreamContent(fileData);
                streamContent.Headers.ContentType = new MediaTypeHeaderValue(file.ContentType);
                content.Add(streamContent, "image", file.Name);

                var response = await Http.PostAsync($"{ApiConfig.BaseUrl}/images/upload", content);
                if (response.IsSuccessStatusCode)
                {
                    successCount++;
                    var result = await response.Content.ReadFromJsonAsync<UploadResult>();
                    if (result is not null) uploadedIds.Add(result.Id);
                }
                else
                {
                    errors.Add($"{file.Name}: {await response.Content.ReadAsStringAsync()}");
                }
            }
            catch (Exception ex)
            {
                if (ex.Message.Contains("exceeds the maximum"))
                {
                    var fileSizeMb = (file.Size / (1024.0 * 1024.0)).ToString("F1");
                    errors.Add($"{file.Name}: exceeds the maximum size of 10 MB ({fileSizeMb} MB).");
                }
                else
                {
                    errors.Add($"{file.Name}: {ex.Message}");
                }
            }
        }

        if (successCount > 0)
        {
            // Uploading while inside a folder files the new photos there.
            if (currentFolder is not null && uploadedIds.Count > 0)
            {
                await Http.PostAsJsonAsync($"{ApiConfig.BaseUrl}/images/move",
                    new { imageIds = uploadedIds, folderId = currentFolder.Id });
            }
            await RefreshAsync();
        }

        if (errors.Count == 0)
        {
            uploadStatus = successCount == 1 ? "Image uploaded successfully!" : $"{successCount} images uploaded successfully!";
            uploadSuccess = true;
        }
        else
        {
            var prefix = successCount > 0 ? $"{successCount} uploaded, {errors.Count} failed: " : "Upload failed: ";
            uploadStatus = prefix + string.Join("; ", errors);
            uploadSuccess = false;
        }

        isUploading = false;
        _ = DismissToastAfterDelay();
    }

    private async Task DismissToastAfterDelay()
    {
        toastCts?.Cancel();
        toastCts = new CancellationTokenSource();
        var token = toastCts.Token;

        try
        {
            await Task.Delay(4000, token);
            uploadStatus = null;
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private async Task ShowModal(string id)
    {
        selectedId = id;
        imageMetadata = null;
        showModal = true;
        try
        {
            imageMetadata = await Http.GetFromJsonAsync<ImageMetadata>($"{ApiConfig.BaseUrl}/images/{id}/info");
        }
        catch { }
        StateHasChanged();
    }

    private void DeleteImage()
    {
        if (selectedId is null) return;
        confirmDeleteCount = 1;
        confirmDeleteAction = PerformDeleteImage;
        showConfirmDelete = true;
    }

    private async Task PerformDeleteImage()
    {
        if (selectedId is null) return;

        var response = await Http.DeleteAsync($"{ApiConfig.BaseUrl}/images/{selectedId}");
        if (response.IsSuccessStatusCode)
        {
            images?.RemoveAll(i => i.Id == selectedId);
            selectedIds.Remove(selectedId);
            showModal = false;
            await LoadFoldersAsync();
            StateHasChanged();
        }
    }

    private async Task OnConfirmDelete()
    {
        showConfirmDelete = false;
        if (confirmDeleteAction != null)
            await confirmDeleteAction();
    }

    private void CloseModal()
    {
        showModal = false;
    }
}
